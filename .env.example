# development | production | test
NODE_ENV=production

# Log level for pino (trace|debug|info|warn|error|fatal|silent).
LOG_LEVEL=info

# HTTP port the registry listens on.
PORT=3100

# Path to the YAML configuration file (core_base_url / default_hamming_threshold_pct / database).
CONFIG_PATH=./config/config.yaml

# PostgreSQL connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/asset_dedup_registry
