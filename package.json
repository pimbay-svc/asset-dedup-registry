{
  "name": "@pimbay/asset-dedup-registry",
  "private": true,
  "version": "1.0.1",
  "description": "Stateful indexing/evaluation layer for the asset-dedup ecosystem - stores hashes and precomputed similarity edges, exposes duplicate lookup/grouping.",
  "license": "Unlicense",
  "author": {
    "name": "Jan Sarmir",
    "email": "sarmir@pimbay.dev",
    "url": "https://pimbay.dev"
  },
  "homepage": "https://pimbay.dev",
  "repository": {
    "type": "git",
    "url": "https://codeberg.org/pimbay-svc/asset-dedup-registry"
  },
  "bugs": {
    "url": "https://github.com/pimbay-svc/asset-dedup-registry/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "audit:prod": "npm audit --omit=dev",
    "cli": "node --env-file-if-exists=.env dist/presentation/cli/cli.js",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "js:build": "tsc -p tsconfig.build.json",
    "js:format": "prettier --check .",
    "js:format:fix": "prettier --write .",
    "js:lint": "eslint src test",
    "js:lint:fix": "eslint src test --fix",
    "js:typecheck": "tsc --noEmit",
    "migrate": "node --env-file-if-exists=.env dist/infrastructure/drizzle/migrate.js",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test:all": "vitest run test/unit test/integration",
    "test:coverage": "vitest run --coverage test/unit test/integration",
    "test:integration": "vitest run test/integration",
    "test:mutation": "stryker run",
    "test:mutation:snapshot": "rm -f .stryker/incremental.json && stryker run && node .stryker/format-incremental.js",
    "test:unit": "vitest run test/unit"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.0",
    "@pimbay/search-query": "^1.0.0",
    "@pimbay/search-query-drizzle": "^1.0.0",
    "awilix": "^13.0.5",
    "commander": "^12.1.0",
    "drizzle-orm": "^0.45.2",
    "fast-glob": "^3.3.3",
    "fastify": "^5.10.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testcontainers/postgresql": "^12.0.4",
    "@tony.ganchev/eslint-plugin-header": "^3.4.4",
    "@types/node": "^24.13.2",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "pg": "^8.22.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.4",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@fastify/static": "^10.1.1"
  }
}
